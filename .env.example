APP_NAME="Sistem Informasi Desa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistem_informasi_desa
DB_USERNAME=root
DB_PASSWORD=

# PRD 8: driver database agar timeout 120 menit & logout perangkat lain andal
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cookie sesi hanya dikirim lewat HTTPS. Dibiarkan kosong sudah aman:
# bawaannya menyala sendiri saat APP_ENV=production. Isi `false` hanya bila
# produksinya memang belum ber-HTTPS — dan itu sebaiknya sementara saja.
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="admin@desa.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Penyimpanan unggahan (fitur 02) ---
# public = disk lokal (pengembangan) | r2 = Cloudflare R2 (produksi)
UPLOAD_DISK=public

# --- Cloudflare R2 --- (dipakai hanya bila UPLOAD_DISK=r2)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

VITE_APP_NAME="${APP_NAME}"
